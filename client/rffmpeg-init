#!/usr/bin/env python3
"""
rffmpeg-init: Dynamic Kubernetes cluster worker discovery and initializer for rffmpeg.
"""

import argparse
import json
import logging
import os
import sqlite3
import ssl
import subprocess
import sys
import time
import urllib.request

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("rffmpeg-init")


def detect_current_namespace():
    """Autodetect current Kubernetes namespace from mounted serviceaccount secret."""
    ns_file = "/var/run/secrets/kubernetes.io/serviceaccount/namespace"
    if os.path.exists(ns_file):
        try:
            with open(ns_file, "r") as f:
                detected = f.read().strip()
                if detected:
                    return detected
        except Exception as e:
            logger.warning(f"Could not read namespace from {ns_file}: {e}")
    return "default"


def parse_args():
    parser = argparse.ArgumentParser(
        description="Dynamic Kubernetes cluster worker discovery and initializer for rffmpeg."
    )
    detected_ns = detect_current_namespace()
    default_ns = (
        os.environ.get("RFFMPEG_WORKER_NAMESPACE")
        or os.environ.get("RFFMPEG_NAMESPACE")
        or os.environ.get("NAMESPACE")
        or detected_ns
    )
    default_label = (
        os.environ.get("RFFMPEG_WORKER_LABEL")
        or os.environ.get("WORKER_LABEL")
        or "app=jellyfin-rffmpeg-worker"
    )
    default_config = os.environ.get("RFFMPEG_CONFIG", "/etc/rffmpeg/rffmpeg.yml")
    default_db = os.environ.get("RFFMPEG_DB", "/config/rffmpeg/rffmpeg.db")
    default_ssh_src = os.environ.get("SSH_KEY_SOURCE", "/etc/rffmpeg-ssh/id_ed25519")
    default_ssh_dst = os.environ.get("SSH_KEY_DEST", "/config/.ssh/id_ed25519")
    default_cache_temp = os.environ.get("CACHE_TEMP_DIR", "/cache/temp")

    parser.add_argument(
        "-n",
        "--namespace",
        default=default_ns,
        help=f"Kubernetes namespace to search for worker pods (default: autodetected '{default_ns}').",
    )
    parser.add_argument(
        "-l",
        "--label",
        dest="worker_label",
        default=default_label,
        help=f"Pod label selector for worker pods (default: '{default_label}').",
    )
    parser.add_argument(
        "-c",
        "--config",
        dest="rffmpeg_config",
        default=default_config,
        help=f"Path to rffmpeg.yml configuration file (default: '{default_config}').",
    )
    parser.add_argument(
        "--db",
        dest="db_path",
        default=default_db,
        help=f"Path to rffmpeg SQLite database (default: '{default_db}').",
    )
    parser.add_argument(
        "--ssh-key-source",
        default=default_ssh_src,
        help=f"Source path of private SSH key (default: '{default_ssh_src}').",
    )
    parser.add_argument(
        "--ssh-key-dest",
        default=default_ssh_dst,
        help=f"Destination path for private SSH key (default: '{default_ssh_dst}').",
    )
    parser.add_argument(
        "--cache-temp-dir",
        default=default_cache_temp,
        help=f"Shared transcode temporary directory (default: '{default_cache_temp}').",
    )
    return parser.parse_args()


def setup_filesystem(args):
    """Ensure required directories exist and copy SSH key with strict permissions."""
    os.makedirs("/config/.ssh", exist_ok=True)
    os.makedirs("/config/rffmpeg", exist_ok=True)
    os.makedirs("/config/log", exist_ok=True)
    os.makedirs(args.cache_temp_dir, exist_ok=True)

    if os.path.exists(args.ssh_key_source):
        logger.info(f"Copying SSH key from {args.ssh_key_source} to {args.ssh_key_dest}...")
        with open(args.ssh_key_source, "rb") as src, open(args.ssh_key_dest, "wb") as dst:
            dst.write(src.read())
        os.chmod(args.ssh_key_dest, 0o600)
        logger.info(f"Set permissions 0600 on {args.ssh_key_dest}")

    # Ensure current UID exists in /etc/passwd for OpenSSH client
    import pwd
    uid = os.getuid()
    try:
        pwd.getpwuid(uid)
    except KeyError:
        gid = os.getgid()
        logger.info(f"Adding UID {uid} to /etc/passwd for OpenSSH client compatibility...")
        try:
            with open("/etc/passwd", "a") as f:
                f.write(f"jellyfin:x:{uid}:{gid}:jellyfin:/config:/bin/bash\n")
        except Exception as e:
            logger.warning(f"Could not append to /etc/passwd: {e}")


def init_database(args):
    """Initialize rffmpeg database if not present."""
    os.environ["RFFMPEG_CONFIG"] = args.rffmpeg_config
    if not os.path.exists(args.db_path):
        logger.info("Initializing rffmpeg database...")
        subprocess.run(["rffmpeg", "init", "-y", "--no-root"], check=True)


def discover_worker_nodes(namespace, worker_label):
    """Query in-cluster Kubernetes API to discover worker node IPs."""
    token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    token = ""
    if os.path.exists(token_file):
        with open(token_file) as f:
            token = f.read().strip()

    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    ctx = ssl.create_default_context(cafile=ca_file) if os.path.exists(ca_file) else None
    headers = {"Authorization": f"Bearer {token}"} if token else {}

    api_url = f"https://kubernetes.default.svc/api/v1/namespaces/{namespace}/pods?labelSelector={worker_label}"

    discovered_nodes = set()
    logger.info(f"Discovering worker pods matching '{worker_label}' in namespace '{namespace}'...")

    for attempt in range(6):
        try:
            req = urllib.request.Request(api_url, headers=headers)
            with urllib.request.urlopen(req, context=ctx, timeout=5) as resp:
                data = json.loads(resp.read().decode())
                for pod in data.get("items", []):
                    pod_ip = pod.get("status", {}).get("podIP") or pod.get("status", {}).get("hostIP")
                    phase = pod.get("status", {}).get("phase", "")
                    if pod_ip and phase != "Failed":
                        discovered_nodes.add(pod_ip)
        except Exception as e:
            logger.warning(f"Kubernetes API query attempt {attempt + 1} failed: {e}")

        if discovered_nodes:
            break
        logger.info("Waiting 5s for worker pods to be assigned IP addresses...")
        time.sleep(5)

    return discovered_nodes


def sync_rffmpeg_hosts(args, discovered_nodes):
    """Synchronize discovered worker node IPs with rffmpeg SQLite database."""
    conn = sqlite3.connect(args.db_path)
    cur = conn.cursor()
    cur.execute("SELECT hostname FROM hosts")
    current_hosts = {row[0] for row in cur.fetchall()}
    conn.close()

    logger.info(f"Current hosts in rffmpeg: {sorted(list(current_hosts))}")
    logger.info(f"Discovered worker node IPs: {sorted(list(discovered_nodes))}")

    # Remove stale hosts
    for host in current_hosts - discovered_nodes:
        logger.info(f"Removing obsolete worker host: {host}")
        subprocess.run(["rffmpeg", "remove", host])

    # Add new hosts
    for host in discovered_nodes - current_hosts:
        logger.info(f"Adding new worker host: {host}")
        subprocess.run(["rffmpeg", "add", host])


def main():
    args = parse_args()
    os.environ["RFFMPEG_CONFIG"] = args.rffmpeg_config

    setup_filesystem(args)
    init_database(args)

    nodes = discover_worker_nodes(args.namespace, args.worker_label)
    if not nodes:
        logger.warning(
            "No worker node IPs discovered! rffmpeg will rely on local fallback until workers are ready."
        )
    else:
        sync_rffmpeg_hosts(args, nodes)

    logger.info("rffmpeg initialization complete. Current status:")
    subprocess.run(["rffmpeg", "status"])


if __name__ == "__main__":
    main()
